# Mythos v1.0 — Variables de entorno
# Copiá este archivo a .env y completá los valores reales.
# Para Vercel: agregar en Dashboard > Project > Settings > Environment Variables

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SOLO server-side (endpoints de api/). NUNCA en el frontend ni commiteada.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── CORS de los endpoints de api/ ───────────────────────────────────────────
# Origen del panel. Si no se setea, los handlers caen al dominio de producción
# (https://mythos.com.py). Ponerlo explícito en preview/staging.
ALLOWED_ORIGIN=https://mythos.com.py

# ── Rate limiting (Upstash Redis) ───────────────────────────────────────────
# Si faltan, api/_ratelimit.js hace FAIL-OPEN: no bloquea a nadie. En producción
# deben estar seteadas o los endpoints quedan sin protección anti-flood.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Crons de Vercel ─────────────────────────────────────────────────────────
# Si falta, /api/cron/* queda accesible sin autenticación (fail-open).
CRON_SECRET=

# NOTA: no existe un RESTAURANT_ID por defecto. El restaurante se resuelve
# siempre del contexto: ?r= en la URL, localStorage.mythos_restaurant_id, o
# SUPABASE_CONFIG.restaurantId en deploys de un solo local.
